# Geliştirme imajı: derlenmiş çıktı değil, SDK + "dotnet watch" (kod değişince hot reload).
FROM mcr.microsoft.com/dotnet/sdk:10.0
WORKDIR /app

COPY Directory.Build.props ./
COPY src/ src/
RUN dotnet restore src/Test.API/Test.API.csproj

ENV ASPNETCORE_URLS=http://+:8080 \
    DOTNET_USE_POLLING_FILE_WATCHER=true \
    DOTNET_WATCH_RESTART_ON_RUDE_EDIT=true \
    DOTNET_WATCH_SUPPRESS_LAUNCH_BROWSER=true \
    DOTNET_CLI_TELEMETRY_OPTOUT=1
EXPOSE 8080

ENTRYPOINT ["dotnet", "watch", "run", "--project", "src/Test.API/Test.API.csproj", "--no-launch-profile"]
